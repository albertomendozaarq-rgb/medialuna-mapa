# El navegador no debe quedarse con una copia vieja de index.html después de
# cada despliegue -- la app es de un solo archivo y las ediciones (mapa,
# pinceles, guardado) deben verse de inmediato sin pedirle al usuario que
# haga un refresco forzado. "no-cache" no significa "no guardar": el
# navegador sigue guardando el archivo, pero debe revalidar con el servidor
# (If-None-Match/ETag) antes de usarlo -- si no cambió, el servidor contesta
# 304 sin volver a mandar el archivo completo, así que no sale caro.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json
</IfModule>

# Este HTML autónomo contiene Three.js y todos los modelos embebidos. El
# módulo de compresión del hosting corta la respuesta HTTP/2 al comprimirlo;
# servirlo sin gzip evita el error 500/framing sin afectar imágenes o GLB.
<IfModule mod_env.c>
  <FilesMatch "\.(html|htm)$">
    SetEnv no-gzip 1
  </FilesMatch>
</IfModule>
